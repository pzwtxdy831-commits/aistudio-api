{
  "manifest_version": 3,
  "name": "AIS 反代桥接",
  "version": "1.1.3",
  "description": "Let the local AIS proxy sign and send AI Studio requests through this browser.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://aistudio.google.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://aistudio.google.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://aistudio.google.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "AIS 反代桥接",
    "default_popup": "popup.html"
  }
}